#!/bin/bash

usage() {
    echo "Usage: userhome [-f file] [username]"
}

file="/etc/passwd"
user=""

while [ $# -gt 0 ]; do
    case "$1" in
        --help|--usage) usage; exit 0 ;;
        -f) [ $# -lt 2 ] && { usage >&2; exit 3; }
             file="$2"; shift 2 ;;
        -*) usage >&2; exit 3 ;;
        *) [ -n "$user" ] && { usage >&2; exit 3; }
             user="$1"; shift ;;
     esac
done

[ -z "$user" ] && user=$(id -un)

if [ ! -f "$file" ]; then
    echo "file not found" >&2
    exit 2
fi

line=$(grep "^$user:" "$file")
if [ -z "$line" ]; then
    echo "user not found" >&2
    exit 1
fi

echo "$line" | cut -d: -f6

